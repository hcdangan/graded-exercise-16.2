# Environment variables for the research assistant model
BASE_URL="localhost:11434/v1"
LLM="llama-3.2-1b-q4_k_m"
OPENAI_API_KEY="llama"

# Environment variables for the Laya System One model
LAYA_BASE_URL="localhost:11435/v1/systemone"
LAYA_LLM="Laya-Q8_0"
LAYA_API_KEY="your_laya_api_key_here" # Any string will work if hosted locally

# Travily API key
TAVILY_API_KEY="your_travily_api_key_here"

# Tavily search behaviour: 1 = mock data (no API requests), 0 = live Tavily API
TAVILY_MOCK=1

# LangSmith Configuration
LANGSMITH_API_KEY=lsv2...

# LangSmith tracing (set by the LangGraph Studio setup)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=week16-research-agent